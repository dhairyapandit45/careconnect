# =====================================================
# CareConnect Environment Variables Reference (.env.example)
# Duplicate this file as .env in server/ and client/ or root
# =====================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/careconnect

# Authentication / JWT
JWT_SECRET=careconnect_development_jwt_secret_must_be_long_and_secure_key
JWT_EXPIRES_IN=7d

# CORS / Client Origin
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional / Future AI Services (Stubbed in architecture)
OPENAI_API_KEY=your_optional_openai_api_key_here

# Frontend Configuration (Used by Vite in client/)
VITE_API_BASE_URL=http://localhost:5000/api/v1
